{
  "name": "Schiaccia PDF",
  "short_name": "Schiaccia PDF",
  "description": "Alleggerisci PDF e foto JPG direttamente sul dispositivo.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#6fd0f2",
  "theme_color": "#6fd0f2",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?condividi=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "video/*",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm",
            ".mkv"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-matroska": [
          ".mkv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
